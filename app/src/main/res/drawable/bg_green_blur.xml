<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base green gradient -->
    <item>
        <shape>
            <gradient
                android:startColor="#66BB6A"
                android:centerColor="#4CAF50"
                android:endColor="#388E3C"
                android:angle="135"
                android:type="linear" />
        </shape>
    </item>
    <!-- Blur overlay effect -->
    <item>
        <shape>
            <solid android:color="#30FFFFFF" />
        </shape>
    </item>
    <!-- Pattern overlay for blur effect -->
    <item>
        <shape>
            <gradient
                android:startColor="#10FFFFFF"
                android:centerColor="#20FFFFFF"
                android:endColor="#10FFFFFF"
                android:angle="45"
                android:type="radial"
                android:gradientRadius="300dp" />
        </shape>
    </item>
</layer-list>