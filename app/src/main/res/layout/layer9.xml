<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/green_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Judul -->
        <TextView
            android:id="@+id/tv_judul"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panduan Waris Syariah"
            android:textStyle="bold"
            android:textSize="24sp"
            android:layout_marginTop="10dp"
            android:textColor="#000000"
            android:layout_gravity="center" />

        <!-- Box konten -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#76A67B"
            android:padding="16dp"
            android:layout_marginTop="20dp"
            android:elevation="2dp">

            <!-- Gambar bulan bintang -->
            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/bulan_bintang"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Icon Islam" />

            <!-- Dasar hukum -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dasar hukum:\nSurat An-Nisa ayat 11, 12, dan 176,\nHadis Nabi SAW, Ijma' Ulama, Qiyas"
                android:textAlignment="center"
                android:textSize="14sp"
                android:textColor="#FFFFFF" />

            <!-- Bagian waris -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bagian waris (Furudh):"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="16dp"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Suami → 1/2 jika tidak ada anak, 1/4 jika ada anak.\n\n• Istri → 1/4 jika tidak ada anak, 1/8 jika ada anak.\n\n• Anak laki-laki dan perempuan → Laki-laki mendapat 2 bagian dari perempuan.\n\n• Ibu → 1/3 jika tidak ada anak dan saudara, 1/6 jika ada anak.\n\n• Ayah → 1/6 jika ada anak, bisa lebih jika tidak ada anak."
                android:textSize="14sp"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Tombol kembali bawah -->
        <Button
            android:id="@+id/btn_kembali"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kembali"
            android:layout_marginTop="24dp"
            android:background="@drawable/rounded_button"
            android:textColor="#000000"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>