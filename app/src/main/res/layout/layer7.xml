<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/green_gradient"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Tombol Kembali -->
        <Button
            android:id="@+id/btnKembali"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:background="@android:color/transparent"
            android:drawableLeft="@drawable/ic_arrow_back"
            android:drawablePadding="8dp"
            android:padding="0dp"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- Judul -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HASIL PEMBAGIAN WARISAN"
            android:textStyle="bold"
            android:textSize="24sp"
            android:textColor="#000000"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Informasi Pewaris -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/oval_background"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:layout_gravity="center">

            <TextView
                android:id="@+id/tvGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jenis Kelamin Pewaris: -"
                android:textColor="#000000"
                android:textSize="16sp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/tvMaritalStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: -"
                android:textColor="#000000"
                android:textSize="16sp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/tvParentCondition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kondisi Orang Tua: -"
                android:textColor="#000000"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvGrandfatherCondition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kondisi Kakek: -"
                android:textColor="#000000"
                android:textSize="16sp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/tvGrandmotherCondition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kondisi Nenek: -"
                android:textColor="#000000"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Informasi Kekayaan -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/oval_background"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvTotalWealth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Harta: Rp 0"
                android:textColor="#000000"
                android:textSize="16sp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/tvSiblingCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jumlah Anak: 0"
                android:textColor="#000000"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvJenisHarta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jenis Harta: -"
                android:textColor="#000000"
                android:textSize="16sp"
                android:paddingTop="4dp" />
        </LinearLayout>

        <!-- Tabel Hasil Warisan -->
        <TableLayout
            android:id="@+id/tableResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/oval_background"
            android:padding="12dp"
            android:stretchColumns="0,1,2"
            android:layout_marginBottom="16dp">

            <TableRow>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ahli Waris"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:padding="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bagian"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:padding="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Persentase"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:padding="8dp" />
            </TableRow>
        </TableLayout>

        <!-- Tombol Simpan -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Simpan"
            android:background="@drawable/rounded_button"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />
    </LinearLayout>
</ScrollView>