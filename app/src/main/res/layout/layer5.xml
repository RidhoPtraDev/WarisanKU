<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/green_gradient"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Tombol Kembali -->
        <Button
            android:id="@+id/btnKembali"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:background="@android:color/transparent"
            android:drawableLeft="@drawable/ic_arrow_back"
            android:drawablePadding="8dp"
            android:padding="0dp"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- Judul -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INPUT DATA PEWARIS"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Label Jumlah Saudara -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jumlah Anak Pewaris"
            android:textSize="16sp"
            android:textColor="#000000"
            android:background="@drawable/green_gradient"
            android:padding="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Saudara Laki-laki -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:background="@drawable/oval_background"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Anak Laki-laki"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etSaudaraLaki"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:background="@android:drawable/edit_text"
                android:text=""
                android:gravity="center"/>
        </LinearLayout>

        <!-- Saudara Perempuan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:background="@drawable/oval_background"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Anak Perempuan"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etSaudaraPerempuan"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:background="@android:drawable/edit_text"
                android:text=""
                android:gravity="center"/>
        </LinearLayout>

        <!-- Label Kondisi Kakek-Nenek -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kondisi kakek-nenek"
            android:textSize="16sp"
            android:textColor="#000000"
            android:background="@drawable/green_gradient"
            android:padding="8dp"
            android:layout_marginBottom="8dp" />

        <!-- RadioGroup Kondisi Kakek-Nenek -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/oval_background"
            android:padding="16dp"
            android:layout_marginBottom="32dp">

            <RadioGroup
                android:id="@+id/rgKakekNenek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbKakekHidupNenekMeninggal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kakek hidup, nenek meninggal"
                    android:buttonTint="#2E7D32"/>

                <RadioButton
                    android:id="@+id/rbNenekHidupKakekMeninggal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nenek hidup, kakek meninggal"
                    android:buttonTint="#2E7D32"/>

                <RadioButton
                    android:id="@+id/rbKeduanyaMeninggal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kakek dan nenek meninggal"
                    android:buttonTint="#2E7D32"/>

                <RadioButton
                    android:id="@+id/rbKeduanyaHidup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kakek dan nenek hidup"
                    android:buttonTint="#2E7D32"/>
            </RadioGroup>
        </LinearLayout>

        <!-- Tombol Lanjut -->
        <Button
            android:id="@+id/btnLanjut"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Lanjut"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/rounded_button" />
    </LinearLayout>
</ScrollView>